# LLM
LLM_PROVIDER=anthropic          # anthropic | fake
LLM_MODEL=                      # vision-capable model ID (required for a real provider)
ANTHROPIC_API_KEY=              # required when LLM_PROVIDER=anthropic
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2               # SDK retries for transient errors (connection, 5xx, 429)
WORKFLOW_RECURSION_LIMIT=10

# Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760
DATABASE_URL=sqlite:///./data/eduvision.db

# Logging
LOG_LEVEL=INFO
